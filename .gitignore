# Local environments and regenerable build/cache files.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.DS_Store
@eaDir/
.oscar_settings.json
*.log
.runtime/
archive/
tmp/
/manuscript/
/submissions/

# Prepared data and scientific outputs are distributed as release assets.
/data/
/outputs/**
/oscar/**/*.nc
/oscar_origin/**/*.nc
/inputs/driver_build_sources/**/*.nc
/inputs/driver_build_sources/**/*.nc4
/inputs/robinson_k_error_support/*.nc
/inputs/raw/**/*.tif
/inputs/raw/**/*.tiff
*.tar.gz

